ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-test-app/test_app.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-test-app/test_app.rb"

workspace 'VideoOverlayExample.xcworkspace'

# Inject Info.plist keys via RNTA's :post_install option; a second post_install block replaces its hook.
usage_description_post_install = lambda do |installer|
  info_plist_path = File.join(__dir__, '..', 'node_modules', '.generated', 'ios', 'Info.plist')
  unless File.exist?(info_plist_path)
    raise "post_install: expected RNTA-generated Info.plist at #{info_plist_path} but it was missing"
  end

  {
    'NSCameraUsageDescription' => 'This app needs camera access to record video for the overlay demo.',
    'NSMicrophoneUsageDescription' => 'This app needs microphone access to record audio with your video.',
    'NSPhotoLibraryAddUsageDescription' => 'This app needs access to save the burned video to your photo library.',
    # addOnly authorization still requires this key's presence, or the app crashes.
    'NSPhotoLibraryUsageDescription' => 'This app needs access to save the burned video to your photo library.',
    'NSLocationWhenInUseUsageDescription' => 'This app needs your location to stamp it onto the recorded video.',
  }.each do |key, value|
    # Delete first so Add always succeeds, since RNTA's template may already define the key.
    system('/usr/libexec/PlistBuddy', '-c', "Delete :#{key}", info_plist_path, err: File::NULL)
    system('/usr/libexec/PlistBuddy', '-c', "Add :#{key} string \"#{value}\"", info_plist_path)
  end
end

use_test_app!(
  :hermes_enabled => true,
  :fabric_enabled => true,
  :post_install => usage_description_post_install
)
